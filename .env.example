# Neon Postgres connection string (required in production for community builds & metrics)
DATABASE_URL=

# Random 32+ char secret/salt for salted SHA-256 hashing of anonymous views, votes, and rate limits
METRICS_SALT=

# Admin password for /admin/builds post-publish review page and /api/admin/** routes
ADMIN_SECRET=

# Optional Discord webhook URL notified non-blockingly when a new community build is published
DISCORD_BUILD_WEBHOOK_URL=

# Optional Discord webhook URL notified privately when feedback is submitted (never falls back to DISCORD_BUILD_WEBHOOK_URL)
DISCORD_FEEDBACK_WEBHOOK_URL=

# Optional Cloudflare Turnstile keys for anti-bot verification on build submission
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
